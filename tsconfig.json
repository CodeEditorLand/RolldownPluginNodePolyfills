{
	"compilerOptions": {
		"baseUrl": "./",
		"declaration": true,
		"declarationDir": "dist",
		"emitDeclarationOnly": true,
		"isolatedDeclarations": true,
		"isolatedModules": true,
		"module": "ES2020",
		"moduleResolution": "node",
		"outDir": "Target",
		"rootDir": "src",
		"strict": true,
		"target": "es2018"
	},
	"extends": "@playform/build/tsconfig",
	"include": [
		"src",
		"src",
		"src",
		"src"
	]
}
